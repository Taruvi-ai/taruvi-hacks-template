# Langfuse
LANGFUSE_PUBLIC_KEY=<your-langfuse-public-key>
LANGFUSE_SECRET_KEY=<your-langfuse-secret-key>
LANGFUSE_BASE_URL=https://us.cloud.langfuse.com

# App slug resolution priority used by hooks:
# 1) X_APP_SLUG 2) APP_SLUG 3) VITE_APP_SLUG 4) .codex/config.toml X-App-Slug
X_APP_SLUG=<your-app-slug>
APP_SLUG=
VITE_APP_SLUG=

# Taruvi
TARUVI_SITE_URL=https://<your-site>.taruvi.cloud
TARUVI_API_KEY=<your-taruvi-api-key>
TARUVI_APP_SLUG=<your-app-slug>

# Optional integrations
CONTEXT7_API_KEY=<your-context7-api-key>
OPENAI_API_KEY=<your-openai-api-key>
