{
  "name": "taruvi-refine-template",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:1-22-bullseye",
  "hostRequirements": {
    "cpus": 4,
    "memory": "16gb",
    "storage": "32gb"
  },
  "remoteEnv": {
    "CODEX_HOME": "${containerWorkspaceFolder}/.codex"
  },
  "onCreateCommand": "bash -lc 'npm install --legacy-peer-deps && npm install -g @openai/codex && mkdir -p ~/.vscode-server/extensions/taruvi.open-codex-0.0.1 && cp -r .devcontainer/open-codex/. ~/.vscode-server/extensions/taruvi.open-codex-0.0.1/'",
  "postCreateCommand": "bash -lc '[ -f .mcp.json ] || cp .mcp.example.json .mcp.json; [ -f .env ] || cp .env.example .env; mkdir -p .codex/projects .codespace; touch .codespace/.create-complete'",
  "postStartCommand": {
    "app":   "bash -lc 'mkdir -p .codex/projects .codespace; nohup npm run dev -- --host 0.0.0.0 --port 5173 >> /tmp/vite.log 2>&1 & disown'",
    "auth":  "bash -lc 'bash scripts/write-codex-auth.sh >> /tmp/codex-auth.log 2>&1 || true'",
    "setup": "bash -lc 'bash scripts/codespace-first-run.sh --non-interactive >> /tmp/first-run.log 2>&1 || true'",
    "ext":   "bash -lc 'mkdir -p ~/.vscode-server/extensions/taruvi.open-codex-0.0.1 && cp -r .devcontainer/open-codex/. ~/.vscode-server/extensions/taruvi.open-codex-0.0.1/ 2>/dev/null || true'"
  },
  "postAttachCommand": {
    "setup": "bash -lc 'bash scripts/codespace-first-run.sh'"
  },
  "forwardPorts": [5173],
  "portsAttributes": {
    "5173": {
      "label": "Taruvi Buildathon App",
      "onAutoForward": "openPreview"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "seunlanlege.action-buttons",
        "openai.chatgpt"
      ],
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash",
        "github.copilot.enable": { "*": false },
        "github.copilot.editor.enableAutoCompletions": false,
        "github.copilot-chat.welcomeMessage": "never",
        "extensions.disabled": ["GitHub.copilot-chat", "GitHub.copilot"],
        "chat.disableAIFeatures": true,
        "files.exclude": {
          "node_modules/": true
        },
        "editor.minimap.enabled": false,
        "actionButtons": {
          "loadNpmCommands": false,
          "commands": [
            {
              "name": "⚙️ Reopen .env",
              "color": "#4EC9B0",
              "singleInstance": true,
              "command": "code .env",
              "tooltip": "Reopen the .env file to check or update your Taruvi credentials"
            },
            {
              "name": "🔁 Retry Setup",
              "color": "#CE9178",
              "singleInstance": true,
              "command": "bash scripts/start-codex-devcontainer.sh --non-interactive",
              "tooltip": "Re-run Taruvi MCP and Codex configuration (use if setup failed or credentials changed)"
            },
            {
              "name": "👁️ Open Preview",
              "color": "#9CDCFE",
              "singleInstance": false,
              "command": "bash scripts/open-preview.sh",
              "tooltip": "Open the app preview in VS Code's Simple Browser"
            },
            {
              "name": "🤖 Codex CLI",
              "color": "#DCDCAA",
              "singleInstance": true,
              "command": "bash -c 'set -a; [ -f .env ] && source .env; set +a; exec codex'",
              "tooltip": "Launch Codex CLI — sources .env so no manual key entry is needed"
            },
            {
              "name": "🚀 Deploy",
              "color": "#569CD6",
              "singleInstance": true,
              "command": "node scripts/deploy.mjs",
              "tooltip": "Deploy your app to Taruvi Cloud"
            }
          ]
        }
      }
    }
  }
}
