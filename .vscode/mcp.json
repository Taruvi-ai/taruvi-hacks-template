{
  "inputs": [
    {
      "id": "taruvi-site-url",
      "type": "promptString",
      "description": "Taruvi site URL",
      "default": "${env:TARUVI_SITE_URL}"
    },
    {
      "id": "taruvi-api-key",
      "type": "promptString",
      "description": "Taruvi API key",
      "password": true,
      "default": "${env:TARUVI_API_KEY}"
    },
    {
      "id": "taruvi-app-slug",
      "type": "promptString",
      "description": "Taruvi app slug",
      "default": "${env:TARUVI_APP_SLUG}"
    },
    {
      "id": "context7-api-key",
      "type": "promptString",
      "description": "Context7 API key",
      "password": true,
      "default": "${env:CONTEXT7_API_KEY}"
    }
  ],
  "servers": {
    "taruvi": {
      "url": "${input:taruvi-site-url}/mcp/",
      "headers": {
        "Authorization": "Api-Key ${input:taruvi-api-key}",
        "X-App-Slug": "${input:taruvi-app-slug}"
      }
    },
    "context7": {
      "command": "npx",
      "args": ["-y", "@upstash/context7-mcp", "--api-key", "${input:context7-api-key}"]
    }
  }
}
